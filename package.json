{
  "name": "mealora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "Frontend",
    "Backend",
    "Database"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,VITE\" -c \"yellow.bold,cyan.bold\" \"node --watch-path=Backend --watch-path=Database Backend/server.js\" \"vite Frontend\"",
    "dev:backend": "node --watch-path=Backend --watch-path=Database Backend/server.js",
    "dev:frontend": "vite Frontend",
    "seed": "node Database/seeds/seedData.js",
    "server": "node --watch-path=Backend --watch-path=Database Backend/server.js",
    "client": "vite Frontend",
    "build": "vite build Frontend",
    "lint": "oxlint",
    "preview": "vite preview Frontend"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.57.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
